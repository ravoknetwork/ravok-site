# ========================================================
# RAVOK NETWORK — CONFIGURAÇÃO DE AMBIENTE (VERCEL / VPS)
# ========================================================
# No Vercel, adicione essas variáveis em:
# Project Settings -> Environment Variables
# ========================================================

# Porta da aplicação (em ambiente local/VPS)
PORT=3000
NODE_ENV=production

# Mercado Pago (Pagamentos Pix Automáticos)
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# Token Secreto para Comunicação com o Plugin Minecraft (RavokSite)
API_TOKEN=ravok_sec_altere_esta_chave_segura

# Senha Mestra do Painel Admin
ADMIN_PASSWORD=ravok2026admin

# Webhook do Discord para Notificações de Vendas e Resgates
DISCORD_WEBHOOK_URL=

# Token do Bot do Discord (Caso rode o bot separadamente)
DISCORD_BOT_TOKEN=
