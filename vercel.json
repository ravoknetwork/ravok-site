{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "*.html",
        "*.css",
        "*.js",
        "images/**",
        "products/**",
        "downloads/**",
        "data/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/images/(.*)",
      "destination": "/api"
    },
    {
      "source": "/products/(.*)",
      "destination": "/api"
    }
  ]
}
